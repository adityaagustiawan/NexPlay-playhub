# Copy to .env and fill in from your Supabase project settings.
# All VITE_* variables are embedded in the client bundle — never put
# service-role or admin keys here.
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Server-only (Vercel function env — never prefix with VITE_).
# Signs the top-up age-verification captcha challenges. If omitted, the
# service-role key is used as the fallback signing secret.
AGE_CAPTCHA_SECRET="a-long-random-string"